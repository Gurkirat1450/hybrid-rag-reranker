# Copy to .env and adjust. No secrets are needed: this project is retrieval only.
EMBED_MODEL=BAAI/bge-small-en-v1.5
# fastembed's ONNX export of cross-encoder/ms-marco-MiniLM-L-6-v2.
RERANK_MODEL=Xenova/ms-marco-MiniLM-L-6-v2
# fastembed model cache (prefetch, build_index and the app all use it). Relative paths
# are resolved from the project root.
FASTEMBED_CACHE_PATH=.fastembed_cache
# ONNX runtime threads per model, and batch sizes. Kept small to bound memory.
ONNX_THREADS=1
EMBED_BATCH_SIZE=16
RERANK_BATCH_SIZE=8
VECTOR_POOL=30
BM25_POOL=30
RERANK_POOL=20
RRF_K=60
MAX_TOP_K=10
MAX_QUERY_CHARS=300
RATE_LIMIT_PER_MIN=20
INDEX_DIR=index
# Set to 1 only when running behind a trusted reverse proxy (e.g. Hugging Face Spaces).
TRUST_PROXY=0
